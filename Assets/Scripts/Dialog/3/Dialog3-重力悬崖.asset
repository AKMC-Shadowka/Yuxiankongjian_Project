  Dialog_Ele:
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "emmm....\u8FD9\u91CC\u867D\u7136\u662F\u60AC\u5D16\uFF0C\u4F46\u662F\u5899\u9762\u5EF6\u4F38\u51FA\u53BB\u4E86\u3002"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u5982\u679C\u6211\u5207\u6362\u5230\u91CD\u529B\u6A21\u5F0F\uFF0C\u90A3\u4E48\u6211\u662F\u5B8C\u5168\u6709\u673A\u4F1A\u8E29\u7740\u77F3\u9636\u4E0A\u53BB\u7684\u3002"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\u4F46\u662F\u95EE\u9898\u5C31\u968F\u4E4B\u800C\u6765\u4E86\uFF0C\u5982\u679C\u5728\u8FD9\u79CD\u60C5\u51B5\u4E0B\u5207\u6362\u91CD\u529B\u6A21\u5F0F\u7684\u8BDD\uFF0C\u90A3\u6211\u5C31\u5B8C\u86CB\u4E86\uFF0C\u6240\u4EE5\u8FD8\u662F\u4E0D\u8981\u8F7B\u4E3E\u5984\u52A8\u4E86\u3002"
    Sound: {fileID: 0}
  - Name: 
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\uFF08\u65E0\u5730\u9762\u533A\u57DF\u53EA\u80FD\u901A\u8FC7\u91CD\u529B\u6A21\u5F0F\u8FDB\u884C\u63A2\u7D22\uFF0C\u4E00\u65E6\u8FDB\u5165\u65E0\u91CD\u529B\u533A\u57DF\u5C31\u65E0\u6CD5\u5207\u6362\u91CD\u529B\u6A21\u5F0F\uFF0C\u76F4\u5230\u56DE\u5230\u6709\u5730\u9762\u7684\u533A\u57DF\uFF09"
    Sound: {fileID: 0}
