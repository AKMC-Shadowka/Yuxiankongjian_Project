  Dialog_Ele:
  - Name: 
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\uFF08\u7B80\u964B\u7684\u5A5A\u793C\u73B0\u573A\uFF0C\u7EA2\u70DB\u5374\u900F\u7740\u4E00\u80A1\u8BE1\u5F02\u3002\u962E\u6E05\u6885\u7A7F\u7740\u8FD9\u8EAB\u5AC1\u8863\uFF0C\u6797\u6C34\u751F\u7D27\u7D27\u63E1\u7740\u5979\u7684\u624B\u3002\u5802\u91CC\u6CA1\u4EBA\uFF0C\u4F46\u6709\u7A83\u7A83\u79C1\u8BED\u58F0\uFF09"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u5979\u90A3\u4E48\u4FCA\uFF0C\u53C8\u4E0D\u7231\u8BF4\u8BDD\uFF0C\u80AF\u5B9A\u662F\u4E2A\u9E21\u9B3C\uFF01"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 61fd3b78ead5a634c8a5e35c0017e921, type: 3}
    Content: "\u65E9\u8BF4\u4E86\u9E21\u9B3C\u5C31\u8981\u4E00\u76F4\u9694\u5F00\u751F\u6D3B\uFF0C\u5979\u80AF\u5B9A\u662F\u7ED9\u54B1\u4EEC\u4E0B\u5492\u4E86"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u5FC5\u987B\u9694\u5F00\u751F\u6D3B\xB7\xB7\xB7"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 61fd3b78ead5a634c8a5e35c0017e921, type: 3}
    Content: "\u8BA9\u5979\u642C\u5230\u5C71\u4E0A\u53BB\xB7\xB7\xB7"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u6C34\u751F\uFF01\u4F60\u88AB\u5979\u8499\u853D\u4E86\uFF01\u6751\u5934\u738B\u5BB6\u7684\u9E21\u5C31\u6B7B\u4E86\u4E00\u5730\uFF01\u8FD9\u5C31\u662F\u94C1\u8BC1\uFF01\u5979\u5C31\u662F\u2018\u9E21\u9B3C\u2019\uFF01"
    Sound: {fileID: 0}
