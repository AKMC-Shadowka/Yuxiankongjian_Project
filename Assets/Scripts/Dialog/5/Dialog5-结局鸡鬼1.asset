  Dialog_Ele:
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\u6211\u5168\u90FD\u77E5\u9053\u4E86\u3002\u867D\u7136\u73B0\u5728\u4E0D\u80FD\u8BC1\u660E\u4F60\u4EEC\u662F\u9E21\u9B3C\uFF0C\u800C\u4E14\u4F60\u4EEC\u4E5F\u4E0D\u60F3\u53BB\u5BB3\u4EBA\uFF0C\u4F46\u662F\u7684\u786E\u6709\u5F88\u591A\u4EBA\u56E0\u4E3A\u548C\u4F60\u4EEC\u63A5\u89E6\u8FC7\u5012\u4E86\u5927\u9709\u3002"
    Sound: {fileID: 0}
  - Name: "\u962E\u6E05\u6885"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: f837c29457da138489cd518fc915ba0a, type: 3}
    Content: "\u4F3C\u4E4E\u9732\u51FA\u60B2\u54C0\u7684\u5FAE\u7B11\uFF09\u662F\u5417\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: d7d38dfbf97e3604c9fbd118e652a276, type: 3}
    Content: "\uFF08\u4E0A\u524D\u4E00\u6B65\uFF09\u6211\u4E0D\u80FD\u4FDD\u8BC1\u4F60\u4EEC\u548C\u9E21\u9B3C\u50CF\u5BF9\u5176\u4ED6\u4EBA\u6CA1\u6709\u5371\u5BB3\uFF0C\u6240\u4EE5\u5BF9\u4E0D\u8D77\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\u962E\u6E05\u6885"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: f837c29457da138489cd518fc915ba0a, type: 3}
    Content: "\u4F60\u771F\u7684\u5F88\u50CF\u4ED6\u4EEC\u5462\uFF0C\u6027\u5B50\u50CF\u957F\u660E\uFF0C\u773C\u775B\u50CF\u6C34\u751F\uFF0C\u58F0\u97F3\u50CF\u6708\u7075\u3002\u7F62\u4E86\uFF0C\u4F60\u5E94\u8BE5\u6709\u65B9\u6CD5\u6740\u4E86\u6211\uFF0C\u53BB\u505A\u5427\u3002"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: d7d38dfbf97e3604c9fbd118e652a276, type: 3}
    Content: "\u613F\u4F60\u4EEC\u5982\u679C\u6709\u6765\u751F\u53BB\u4E2A\u597D\u4EBA\u5BB6\uFF0C\u522B\u518D\u6210\u4E3A\u5BB6\u65CF\u7684\u9EBB\u70E6\u4E0E\u7978\u5BB3\u4E86\u3002"
    Sound: {fileID: 0}
