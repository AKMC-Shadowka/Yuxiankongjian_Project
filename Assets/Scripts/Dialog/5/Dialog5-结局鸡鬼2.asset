  Dialog_Ele:
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\uFF08\u770B\u5411\u5B9A\u9B42\u9501\uFF09\u201C\u8FD9\u4E2A\u662F\u4E0D\u662F\u2026\u2026\u80FD\u5E2E\u4F60\u5C11\u53D7\u4E00\u4E9B\u75DB\u82E6\uFF1F\u201D"
    Sound: {fileID: 0}
  - Name: "\u962E\u6E05\u6885"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: f837c29457da138489cd518fc915ba0a, type: 3}
    Content: "\uFF08\u70B9\u5934\uFF09\u201C\u6709\u4E86\u5B9A\u9B42\u9501\uFF0C\u6211\u5E94\u8BE5\u4E5F\u5C31\u80FD\u538B\u5236\u9E21\u9B3C\u4E86\u3002\u201D"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 4490a726431ff3a4d9ecdf550333f91e, type: 3}
    Content: "\uFF08\u62FF\u51FA\u80CC\u5305\u4E2D\u7684\u5AC1\u8863\uFF09\u201C\u90A3\u5C31\u597D\u3002\u8FD9\u4E2A\u5E94\u8BE5\u662F\u4F60\u4EEC\u5176\u4E2D\u4E00\u4F4D\u51FA\u5AC1\u65F6\u7A7F\u8FC7\u7684\uFF0C\u62FF\u7740\u5427\u3002\u201D"
    Sound: {fileID: 0}
  - Name: "\u962E\u6E05\u6885"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: f837c29457da138489cd518fc915ba0a, type: 3}
    Content: "\uFF08\u4F3C\u4E4E\u6709\u4E9B\u6000\u5FF5\uFF09\u201C\u6211\u4EEC\u548C\u7231\u7684\u4EBA\u65E9\u5C31\u4E0D\u5728\u5566\u2026\u2026\u6700\u53EF\u601C\u7684\u8FD8\u662F\u5C0F\u6708\u7075\uFF0C\u624D\u90A3\u4E48\u5C0F\uFF0C\u4E5F\u88AB\u8FD9\u4E48\u5BF9\u5F85\u2026\u2026\u201D"
    Sound: {fileID: 0}
  - Name: "\u962E\u6E05\u6885"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: f837c29457da138489cd518fc915ba0a, type: 3}
    Content: "\u4F60\u624B\u91CC\u6709\u4E2A\u7F57\u76D8\u5427\uFF1F\u8BB0\u4E0D\u6E05\u662F\u8C01\u4E86\uFF0C\u62FF\u7740\u8FD9\u4E2A\u7F57\u76D8\u60F3\u8DD1\u5230\u5916\u9762\u53BB\uFF0C\u628A\u6211\u4EEC\u7684\u4E8B\u60C5\u544A\u8BC9\u522B\u4EBA\uFF0C\u4F46\u662F\u7B2C\u4E8C\u5929\u5C31\u6B7B\u5728\u534A\u9053\u4E0A\uFF0C\u6700\u540E\u4E5F\u602A\u5230\u4E86\u2018\u9E21\u9B3C\u2019\u5934\u4E0A\u3002\u201D"
    Sound: {fileID: 0}
  - Name: "\u962E\u6E05\u6885"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: f837c29457da138489cd518fc915ba0a, type: 3}
    Content: "\u201C\u6BD5\u7ADF\u4F60\u4E5F\u4FEE\u590D\u4E86\u4E0D\u5C11\u4E1C\u897F\uFF0C\u7F57\u76D8\u5E94\u8BE5\u6709\u80FD\u91CF\u53EF\u4EE5\u5E26\u4F60\u51FA\u53BB\uFF0C\u53EA\u8981\u4E00\u76F4\u8D70\uFF0C\u5C31\u80FD\u6495\u5F00\u7A7A\u95F4\u56DE\u5230\u4F60\u539F\u6765\u7684\u5730\u65B9\u3002\u201D"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 4490a726431ff3a4d9ecdf550333f91e, type: 3}
    Content: "\u8C22\u8C22\u4F60\u4EEC\u2026\u2026\u8FD8\u6709\uFF0C\u5BF9\u4E0D\u8D77\uFF0C\u6211\u771F\u7684\u6CA1\u529E\u6CD5\u5E2E\u4F60\u4EEC\u66F4\u591A\u4E86\u2026\u2026"
    Sound: {fileID: 0}
