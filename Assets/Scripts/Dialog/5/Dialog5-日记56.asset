--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a06138dd36b163548b97e378f414deca, type: 3}
  m_Name: "Dialog5-\u65E5\u8BB056"
  m_EditorClassIdentifier: 
  Dialog_Ele:
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u6708\u7075\u90A3\u5B69\u5B50\uFF0C\u773C\u795E\u8D8A\u6765\u8D8A\u50CF\u5979\u5A18\u3002\u5468\u82B8\u90A3\u4E2A\u5916\u4E61\u4EBA\u7ADF\u60F3\u5E26\u5979\u8D70\uFF1F\u4E0D\u884C\uFF01\u5979\u82E5\u51FA\u53BB\u4E71\u8BF4\uFF0C\u2018\u9E21\u9B3C\u2019\u7684\u65E7\u4E8B\u4F1A\u88AB\u7FFB\u51FA\u6765\uFF0C\u6751\u5B50\u4E0D\u80FD\u4E71\uFF01\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u770B\u6765\uFF0C\u666E\u901A\u7684\u9694\u79BB\u6CA1\u7528\u4E86\u3002\u5F97\u7528\u8001\u7956\u5B97\u6700\u540E\u7684\u6CD5\u5B50\u2014\u2014\u5C31\u50CF\u5F53\u5E74\u5BF9\u963F\u59D0\u90A3\u6837\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u6211\u505A\u7684\u662F\u5BF9\u7684\uFF0C\u4E0D\u80FD\u8BA9\u9E21\u9B3C\u6BC1\u6389\u5927\u5BB6\u7684\u751F\u6D3B\u3002"
    Sound: {fileID: 0}
  - Name: 
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u3002\u3002\u3002\u3002\u3002\u3002"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u7ED3\u675F\u4E86\u3002\u6708\u7075\u2026\u2026\u6CA1\u6491\u8FC7\u53BB\u3002\u5979\u6700\u540E\u770B\u7740\u6211\u7684\u773C\u795E\uFF0C\u548C\u963F\u59D0\u4E00\u6A21\u4E00\u6837\u3002\u6E05\u6885\u4E5F\u75AF\u4E86\u3002\u6211\u5750\u5728\u7960\u5802\u91CC\uFF0C\u89C9\u5F97\u5F88\u7D2F\u3002"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u2018\u9E21\u9B3C\u2019\u5230\u5E95\u662F\u4EC0\u4E48\uFF1F\u6211\u4E0D\u77E5\u9053\uFF0C\u4E5F\u4E0D\u613F\u77E5\u9053\u4E86\u3002\u8FD9\u4E1C\u897F\u4E00\u65E6\u5F00\u59CB\uFF0C\u5C31\u505C\u4E0D\u4E0B\u6765\u3002\u4ECE\u6211\u963F\u59D0\uFF0C\u5230\u962E\u6E05\u6885\uFF0C\u518D\u5230\u6797\u6708\u7075\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u4E0B\u4E00\u4E2A\u4F1A\u662F\u8C01\uFF1F\u4F46\u53EA\u8981\u6211\u6D3B\u7740\uFF0C\u8FD9\u89C4\u77E9\u5C31\u4E0D\u80FD\u7834\u3002\u6211\u662F\u4E3A\u4E86\u6751\u5B50\uFF0C\u5BF9\uFF0C\u6211\u662F\u4E3A\u4E86\u6751\u5B50\u2026\u2026"
    Sound: {fileID: 0}
