  m_Script: {fileID: 11500000, guid: a06138dd36b163548b97e378f414deca, type: 3}
  m_Name: "Dialog5-\u65E5\u8BB034"
  m_EditorClassIdentifier: 
  Dialog_Ele:
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u6211\u63A5\u66FF\u4E86\u97E6\u53D4\u516C\u7684\u4F4D\u7F6E\u3002\u6210\u4E86\u65B0\u7684\u2018\u6751\u8001\u2019\u3002\u4ED6\u4EEC\u90FD\u6015\u6211\uFF0C\u4E5F\u656C\u6211\u3002\u6211\u77E5\u9053\uFF0C\u662F\u56E0\u4E3A\u6211\u638C\u63E1\u4E86\u2018\u89C4\u77E9\u2019\u548C\u2018\u53E4\u7406\u2019\u3002\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u4ECA\u5929\u8DEF\u8FC7\u6CB3\u8FB9\uFF0C\u8FD8\u662F\u4E0D\u6562\u770B\u90A3\u4E2A\u6DF1\u6F6D\u3002\u2018\u9E21\u9B3C\u2019\u4E4B\u8BF4\uFF0C\u5B81\u53EF\u4FE1\u5176\u6709\u3002\u6CA1\u4E86\u8FD9\u89C4\u77E9\uFF0C\u6751\u5B50\u4F1A\u4E71\u3002"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u962E\u5BB6\u90A3\u4E2B\u5934\uFF0C\u592A\u50CF\u963F\u59D0\u5E74\u8F7B\u65F6\u4E86\u3002\u6F02\u4EAE\uFF0C\u53C8\u4E0D\u5408\u7FA4\u3002\u6700\u8FD1\u603B\u6709\u5916\u4E61\u4EBA\u6253\u542C\u5979\uFF0C\u4E0D\u80FD\u8BA9\u5979\u628A\u5916\u4EBA\u62DB\u6765\uFF0C\u540E\u5C71\u7684\u2018\u8425\u751F\u2019\u89C1\u4E0D\u5F97\u5149\u3002\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u963F\u864E\u6454\u4E86\uFF0C\u9E21\u4E5F\u6B7B\u4E86\u3002\u662F\u5F81\u5146\u5417\uFF1F\u2026\u2026\u4E5F\u8BB8\uFF0C\u5979\u5C31\u662F\u8FD9\u4E00\u4EE3\u7684\u2018\u9E21\u9B3C\u2019\u3002\u4E3A\u4E86\u6751\u5B50\u7684\u5B89\u5B81\u2026\u2026\u53EA\u80FD\u8FD9\u6837\u4E86\u3002"
    Sound: {fileID: 0}
