  Dialog_Ele:
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\u76F8\u4FE1\u6211\uFF0C\u867D\u7136\u9700\u8981\u65F6\u95F4\uFF0C\u6211\u4F1A\u5C3D\u6211\u6240\u80FD\u5E2E\u52A9\u4F60\u4EEC\u5E73\u53CD\uFF0C\u628A\u8FD9\u4E2A\u5403\u4EBA\u7684\u4F20\u7EDF\u548C\u9519\u8BEF\u7684\u504F\u89C1\u5F7B\u5E95\u7C89\u788E\u3002"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\u201C\u7389\u7C2A\u548C\u624B\u5E15\uFF0C\u5E94\u8BE5\u4E5F\u662F\u4F60\u4EEC\u73CD\u60DC\u7684\u4E1C\u897F\u3002\u5B83\u4EEC\u627F\u8F7D\u7684\u6545\u4E8B\u4E0E\u771F\u76F8\uFF0C\u4E0D\u8BE5\u88AB\u6C38\u8FDC\u57CB\u6CA1\u3002\u201D"
    Sound: {fileID: 0}
  - Name: "\u962E\u6E05\u6885"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: f837c29457da138489cd518fc915ba0a, type: 3}
    Content: "\uFF08\u610F\u5916\u5730\u6CA1\u6709\u8BF4\u8BDD\uFF0C\u53EA\u662F\u6B63\u5728\u6162\u6162\u6D88\u5931\uFF09"
    Sound: {fileID: 0}
  - Name: 
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "\u610F\u8BC6\u95EA\u70C1\u7740\u661F\u661F\u70B9\u70B9\u7684\u5149\u8292\uFF0C\u5F00\u59CB\u6D88\u6563\u3002"
    Sound: {fileID: 0}
