  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a06138dd36b163548b97e378f414deca, type: 3}
  m_Name: "Dialog5-\u65E5\u8BB012"
  m_EditorClassIdentifier: 
  Dialog_Ele:
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u963F\u59D0\u88AB\u5E26\u8D70\u4E86\u3002\u4ED6\u4EEC\u8BF4\u5979\u662F\u2018\u9E21\u9B3C\u2019\uFF0C\u56E0\u4E3A\u674E\u5BB6\u7684\u725B\u6B7B\u4E86\u3002\u5979\u4E00\u76F4\u54ED\uFF0C\u8BF4\u4E0D\u662F\u5979\u3002\u963F\u7239\u963F\u5A18\u4E5F\u54ED\uFF0C\u4F46\u6CA1\u6709\u7528\u3002\u6CB3\u8FB9\u56F4\u4E86\u597D\u591A\u4EBA\u2026\u2026"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u6211\u8EB2\u5728\u77F3\u5934\u540E\u9762\u770B\u3002\u4ED6\u4EEC\u628A\u963F\u59D0\u88C5\u8FDB\u7AF9\u7B3C\uFF0C\u6C89\u4E0B\u53BB\u4E86\u3002\u6C34\u5192\u4E86\u597D\u591A\u6CE1\u6CE1\u2026\u2026\u540E\u6765\u5C31\u6CA1\u4E86\u3002"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u53C8\u6709\u4EBA\u6307\u8BA4\u6751\u5C3E\u7684\u67F3\u5A46\u5A46\u662F\u2018\u9E21\u9B3C\u2019\u3002\u6211\u770B\u5230\u4E86\u548C\u5F53\u5E74\u4E00\u6837\u7684\u773C\u795E\u2014\u2014\u6050\u60E7\uFF0C\u8FD8\u6709\u2026\u2026\u5174\u594B\u3002\u97E6\u53D4\u516C\u4E3B\u6301\u4E86\u4EEA\u5F0F\u3002\u6211\u6CA1\u6562\u8D70\u8FD1\uFF0C\u4F46\u665A\u4E0A\u4E00\u95ED\u773C\u5C31\u662F\u963F\u59D0\u7684\u6837\u5B50\u3002"
    Sound: {fileID: 0}
  - Name: "\uFF1F\uFF1F\uFF1F"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u4E5F\u8BB8\u2026\u2026\u4E5F\u8BB8\u771F\u7684\u5B58\u5728\u2018\u9E21\u9B3C\u2019\u5427\uFF1F\u53EA\u6709\u8FD9\u6837\u60F3\uFF0C\u5FC3\u91CC\u624D\u597D\u53D7\u70B9\u3002\u4E0D\u7136\uFF0C\u963F\u59D0\u4E0D\u5C31\u767D\u6B7B\u4E86\u5417\uFF1F"
    Sound: {fileID: 0}
