    Human: {fileID: 21300000, guid: ab069f5a138a5764a98d52d03296c2f8, type: 3}
    Content: "(\u5B9E\u9A8C\u5BA4\u91CC\u53EA\u6709\u6653\u6708\u7684\u5DE5\u4F5C\u53F0\u4EAE\u7740\u4E00\u76CF\u5B64\u706F\u3002\u5979\u6B63\u4ECE\u81EA\u5DF1\u7684\u5305\u91CC\uFF0C\u5C0F\u5FC3\u7FFC\u7FFC\u5730\u53D6\u51FA\u4E00\u4E2A\u7528\u8F6F\u5E03\u5305\u88F9\u7684\u7269\u4F53\u2014\u2014\u6B63\u662F\u5979\u5BB6\u4E2D\u90A3\u5C0A\u76F8\u4F3C\u7684\u9E21\u9996\u4EBA\u8EAB\u6CE5\u5851\u3002)"
    Sound: {fileID: 0}
