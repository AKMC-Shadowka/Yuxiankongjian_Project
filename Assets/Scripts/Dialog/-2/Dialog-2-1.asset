  m_Script: {fileID: 11500000, guid: a06138dd36b163548b97e378f414deca, type: 3}
  m_Name: Dialog-2-1
  m_EditorClassIdentifier: 
  Dialog_Ele:
  - Name: "\u9EC4\u5E08\u5085"
    Img: {fileID: 21300000, guid: a29c023f27ad34e45852863a878d1984, type: 3}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u7F16\u53F7B-7-13\uFF0C\u6EC7\u5357\u5730\u533A\u6728\u96D5\u2018\u5C71\u795E\u2019\u50CF\uFF0C\u8150\u8680\u4E25\u91CD\u3002\u4FEE\u590D\u6BD4\u8F83\u56F0\u96BE\uFF0C\u5148\u5F52\u6863\u7559\u5B58\u3002"
    Sound: {fileID: 0}
  - Name: "\u5C0F\u738B"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u9EC4\u5DE5\uFF0C\u6653\u6708\uFF0C\u65B0\u6765\u7684\u4E00\u6279\u8D27\uFF0C\u4ECE\u9057\u5740\u5468\u8FB9\u6316\u51FA\u6765\u7684\u3002\u4E1C\u897F\u633A\u6742\uFF0C\u770B\u7740\u90FD\u633A\u6709\u5E74\u5934\u4E86\u3002"
    Sound: {fileID: 0}
  - Name: "\u9EC4\u5E08\u5085"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u5C0F\u738B\uFF0C\u628A\u8FD9\u4E9B\u90FD\u5148\u653E\u5230\u9694\u79BB\u533A\u3002\u6653\u6708\uFF0C\u4F60\u5C24\u5176\u8981\u8BB0\u4F4F\uFF0C\u8FD9\u7C7B\u5E26\u6709\u5F3A\u70C8\u6C11\u4FD7\u4FE1\u4EF0\u7684\u5668\u7269\uFF0C\u5F88\u591A\u8FDE\u7528\u9014\u548C\u6765\u6E90\u90FD\u641E\u4E0D\u6E05\u695A\u3002"
    Sound: {fileID: 0}
  - Name: "\u9EC4\u5E08\u5085"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u90AA\u6027\u2019\u5F97\u5F88\u3002\u5728\u6CA1\u5F04\u6E05\u695A\u4E4B\u524D\uFF0C\u6700\u597D\u522B\u4E71\u52A8\uFF0C\u5C24\u5176\u662F\u665A\u4E0A\u3002"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 648682bc240922d4281db4ce858f4ff5, type: 3}
    Content: "\u6211\u8BB0\u4F4F\u4E86\uFF0C\u9EC4\u5E08\u5085\u3002"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 648682bc240922d4281db4ce858f4ff5, type: 3}
    Content: "\uFF08\u2026\u2026\u5E08\u5085\u4E00\u76F4\u5F88\u8C28\u614E\u3002\u4E0D\u8FC7\uFF0C\u2018\u90AA\u6027\u2019\u662F\u4EC0\u4E48\u9B3C\uFF0C\u8FD8\u4ECE\u6CA1\u8FD9\u4E48\u8BF4\u8FC7\uFF0C\u8FD9\u4E9B\u4E1C\u897F\u770B\u8D77\u6765\u786E\u5B9E\u548C\u535A\u7269\u9986\u91CC\u90A3\u4E9B\u89C4\u6574\u7684\u6587\u7269\u4E0D\u592A\u4E00\u6837\uFF0C\u6709\u79CD\u2026\u2026\u8BF4\u4E0D\u51FA\u7684\u611F\u89C9\u3002\u201D\uFF09 "
    Sound: {fileID: 0}
  - Name: "\u5C0F\u738B"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u8FD9\u6279\u4E1C\u897F\uFF0C\u957F\u7684\u90FD\u5F88\u5947\u602A\uFF0C\u6211\u662F\u6CA1\u770B\u5230\u8FC7\u7C7B\u4F3C\u7684\uFF0C\u611F\u89C9\u662F\u4E2A\u5927\u53D1\u73B0\u4E86\uFF0C
      \u558F\uFF0C\u4F60\u770B\u90A3\u4E2A\uFF0C\u50CF\u4E0D\u50CF\u4E2A\u2026\u2026\u957F\u4E86\u9E21\u5934\u7684\u4EBA\uFF1F"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: bca07f2b266934c4c92d271e29ef4d9a, type: 3}
    Content: "\u9E21\u2026\u2026\u9E21\u9B3C\uFF1F"
    Sound: {fileID: 0}
  - Name: "\u6797\u6653\u6708"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 648682bc240922d4281db4ce858f4ff5, type: 3}
    Content: "\uFF08\u201C\u8FD9\u2026\u2026\u8FD9\u600E\u4E48\u53EF\u80FD\uFF1F\uFF01\u8FD9\u4E2A\u6CE5\u5851\u2026\u2026\u5B83\u7684\u9020\u578B\uFF0C\u548C\u5BB6\u91CC\u9601\u697C\u4E0A\u90A3\u4E2A\uFF0C\u597D\u50CF\uFF01\u201D\uFF09 "
    Sound: {fileID: 0}
  - Name: "\u9EC4\u5E08\u5085"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\u522B\u95F2\u804A\u4E86\uFF0C\u767B\u8BB0\u5DE5\u4F5C\u4E0D\u8981\u51FA\u73B0\u7EB0\u6F0F\uFF01"
    Sound: {fileID: 0}
  - Name: "\u9EC4\u5E08\u5085\uFF1A"
    Img: {fileID: 0}
    Human: {fileID: 21300000, guid: 2e9146a0e9b110e4493b8cdbf0f2d012, type: 3}
    Content: "\uFF08\u8FC7\u4E86\u4E00\u6BB5\u65F6\u95F4)\u6653\u6708\uFF0C\u4E0B\u73ED\u65F6\u95F4\u5230\u4E86\u3002\u628A\u8FD9\u6279\u8BB0\u597D\u7F16\u53F7\u5C31\u65E9\u70B9\u56DE\u53BB\u5427\uFF0C\u8BB0\u4F4F\u6211\u7684\u8BDD\u3002"
    Sound: {fileID: 0}
